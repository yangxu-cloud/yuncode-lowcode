# 后端 API 配置
# 复制此文件为 .env.local 并修改配置

# 前端请求地址
# 选项 1: 直接连接后端（需要后端配置 CORS）
# VITE_API_BASE_URL=http://localhost:8080

# 选项 2: 使用 Vite 代理（推荐，避免跨域）
VITE_API_BASE_URL=/api

# Vite 代理目标地址（当使用代理模式时必需）
# Vite 会将 /api 请求转发到这个地址
VITE_API_PROXY_TARGET=http://localhost:8080

# 第三方服务配置

# SkyWalking UI 地址（链路追踪）
VITE_SKYWALKING_URL=http://localhost:8088

# IP 查询服务 API
VITE_IP_QUERY_API=https://api.ipify.org?format=json

# IP 地理位置查询 API
VITE_IP_LOCATION_API=https://ipapi.co/json/

# 其他配置
VITE_APP_TITLE=Yuncode LowCode
