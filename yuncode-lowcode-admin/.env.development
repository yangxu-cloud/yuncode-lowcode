# 开发环境配置

# 后端 API 地址（前端请求地址）
# 选项 1: 直接连接后端（适用于本地开发，需要后端配置 CORS）
# VITE_API_BASE_URL=http://localhost:8080

# 选项 2: 使用 Vite 代理（避免跨域问题，推荐）
VITE_API_BASE_URL=/api

# Vite 代理目标地址（当使用代理模式时生效）
# 只有当 VITE_API_BASE_URL=/api 时才需要配置此项
VITE_API_PROXY_TARGET=http://localhost:8080

# 第三方服务配置

# SkyWalking UI 地址（链路追踪）
VITE_SKYWALKING_URL=http://localhost:8088

# IP 查询服务 API
VITE_IP_QUERY_API=https://api.ipify.org?format=json

# IP 地理位置查询 API
VITE_IP_LOCATION_API=https://ipapi.co/json/
