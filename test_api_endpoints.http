### API 测试集合
### 使用 REST Client 或类似工具测试

### 变量定义
@baseUrl = http://localhost:8080/api
@token = {{login.response.body.token}}

#############################################
# 1. 登录接口
#############################################
### 登录获取 Token
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "tenantCode": "default",
  "username": "admin",
  "password": "admin123"
}

#############################################
# 2. 系统日志接口
#############################################

### 获取系统日志列表
GET {{baseUrl}}/log/system/list?page=1&size=20
Authorization: Bearer {{token}}

### 获取系统日志列表（带过滤条件）
GET {{baseUrl}}/log/system/list?page=1&size=20&level=ERROR&module=auth
Authorization: Bearer {{token}}

### 删除单条系统日志
DELETE {{baseUrl}}/log/system/1
Authorization: Bearer {{token}}

### 批量删除系统日志
POST {{baseUrl}}/log/system/batch-delete
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ids": [1, 2, 3]
}

### 清空过期日志（30天前）
POST {{baseUrl}}/log/system/clean?days=30
Authorization: Bearer {{token}}

#############################################
# 3. 在线用户接口
#############################################

### 获取在线用户统计
GET {{baseUrl}}/system/online-users/stats
Authorization: Bearer {{token}}

### 获取在线用户列表
GET {{baseUrl}}/system/online-users?page=1&size=20
Authorization: Bearer {{token}}

### 获取当前在线用户信息
GET {{baseUrl}}/system/online-users/current
Authorization: Bearer {{token}}

### 踢出指定用户
POST {{baseUrl}}/system/online-users/{{sessionId}}/kick
Authorization: Bearer {{token}}

### 批量踢出用户
POST {{baseUrl}}/system/online-users/batch-kick
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "sessionIds": ["token1", "token2"]
}

#############################################
# 4. 操作日志接口
#############################################

### 获取操作日志列表
GET {{baseUrl}}/log/operation/list?page=1&size=20
Authorization: Bearer {{token}}

#############################################
# 5. 用户登录日志接口
#############################################

### 获取用户登录日志列表
GET {{baseUrl}}/log/login/list?page=1&size=20
Authorization: Bearer {{token}}

#############################################
# 6. 认证接口
#############################################

### 获取当前用户信息
GET {{baseUrl}}/auth/info
Authorization: Bearer {{token}}

### 检查登录状态
GET {{baseUrl}}/auth/checkLogin
Authorization: Bearer {{token}}

### 登出
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

#############################################
# 7. 调试接口
#############################################

### Token 调试信息
GET {{baseUrl}}/auth/debug/token-info
Authorization: Bearer {{token}}

### 检查登录状态（调试）
GET {{baseUrl}}/auth/debug/check-login
Authorization: Bearer {{token}}

#############################################
# 测试说明
#############################################
# 1. 首先调用登录接口获取 Token
# 2. Token 会自动保存到 @token 变量
# 3. 后续接口会自动使用该 Token
# 4. 如需重新登录，删除 @token 变量或重新执行登录请求
