<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yuncode.system.mapper.SysBoFieldMapper">

    <select id="selectByTableId" resultType="com.yuncode.system.entity.SysBoField">
        SELECT * FROM sys_bo_field
        WHERE table_id = #{tableId} AND deleted = 0
        ORDER BY sort ASC, id ASC
    </select>

    <delete id="deleteByTableId">
        DELETE FROM sys_bo_field WHERE table_id = #{tableId}
    </delete>
</mapper>
