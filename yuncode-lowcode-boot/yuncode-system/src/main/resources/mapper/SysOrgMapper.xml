<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yuncode.system.mapper.SysOrgMapper">

    <!--
        查询所有组织（用于平台管理员，忽略租户限制）
        注意：此方法仅用于平台管理员查看所有租户的组织
        使用 @InterceptorIgnore 注解在 Mapper 接口中忽略多租户插件的自动过滤
    -->
    <select id="selectAllForPlatformAdmin" resultType="com.yuncode.system.entity.SysOrg">
        SELECT *
        FROM sys_org
        WHERE deleted = 0
        ORDER BY sort_order ASC, id ASC
    </select>

    <!--
        根据ID查询组织（忽略租户限制）
        注意：此方法用于查询父组织以继承 company_id，需要忽略租户限制
        使用 @InterceptorIgnore 注解在 Mapper 接口中忽略多租户插件的自动过滤
    -->
    <select id="selectByIdIgnoreTenant" resultType="com.yuncode.system.entity.SysOrg">
        SELECT *
        FROM sys_org
        WHERE id = #{id}
          AND deleted = 0
        LIMIT 1
    </select>

    <!--
        根据ID删除组织（逻辑删除，忽略租户限制）
        注意：此方法用于删除组织时不受租户限制
        使用 @InterceptorIgnore 注解在 Mapper 接口中忽略多租户插件的自动过滤
    -->
    <update id="deleteByIdIgnoreTenant">
        UPDATE sys_org
        SET deleted = 1,
            update_time = NOW()
        WHERE id = #{id}
          AND deleted = 0
    </update>

    <!--
        根据ID物理删除组织（绕过 @TableLogic 逻辑删除）
        注意：此方法会真正从数据库删除记录，而不是设置 deleted = 1
    -->
    <delete id="deletePhysicalById">
        DELETE FROM sys_org
        WHERE id = #{id}
    </delete>

    <!--
        批量物理删除组织（绕过 @TableLogic 逻辑删除）
        注意：此方法会真正从数据库删除记录，而不是设置 deleted = 1
    -->
    <delete id="deletePhysicalByIds">
        DELETE FROM sys_org
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
