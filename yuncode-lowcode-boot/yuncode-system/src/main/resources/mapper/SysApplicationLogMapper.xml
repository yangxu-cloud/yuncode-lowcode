<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yuncode.system.mapper.SysApplicationLogMapper">

    <!--
        分页查询应用日志列表
    -->
    <select id="selectPage" resultType="com.yuncode.system.entity.SysApplicationLog">
        SELECT *
        FROM sys_application_log
        WHERE 1=1
          <if test="appId != null">
              AND app_id = #{appId}
          </if>
          <if test="operationType != null">
              AND operation_type = #{operationType}
          </if>
        ORDER BY create_time DESC
    </select>

</mapper>
