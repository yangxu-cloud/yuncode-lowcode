<script setup lang="ts">
import Motion from "./utils/motion";
import { useRouter } from "vue-router";
import { message } from "@/utils/message";
import { ref, reactive, toRaw } from "vue";
import { debounce } from "@pureadmin/utils";
import { useNav } from "@/layout/hooks/useNav";
import { useEventListener } from "@vueuse/core";
import type { FormInstance } from "element-plus";
import { useLayout } from "@/layout/hooks/useLayout";
import { useUserStoreHook } from "@/store/modules/user";
import { bg, avatar, illustration } from "./utils/static";
import { useRenderIcon } from "@/components/ReIcon/src/hooks";
import { useDataThemeChange } from "@/layout/hooks/useDataThemeChange";

import dayIcon from "@/assets/svg/day.svg?component";
import darkIcon from "@/assets/svg/dark.svg?component";
import Lock from "~icons/ri/lock-fill";
import User from "~icons/ri/user-3-fill";

defineOptions({
  name: "Login"
});

const router = useRouter();
const loading = ref(false);
const disabled = ref(false);
const activeTab = ref("admin");

// 管理员登录表单
const adminFormRef = ref<FormInstance>();
const adminForm = reactive({
  username: "admin",
  password: "admin123"
});

// 普通用户登录表单
const userFormRef = ref<FormInstance>();
const userForm = reactive({
  tenantCode: "",
  username: "",
  password: ""
});

// 租户登录表单
const tenantFormRef = ref<FormInstance>();
const tenantForm = reactive({
  tenantCode: "",
  username: "",
  password: ""
});

const { initStorage } = useLayout();
initStorage();

const { dataTheme, overallStyle, dataThemeChange } = useDataThemeChange();
dataThemeChange(overallStyle.value);
const { title } = useNav();

// 表单验证规则
const adminRules = {
  username: [{ required: true, message: "请输入账号", trigger: "blur" }],
  password: [{ required: true, message: "请输入密码", trigger: "blur" }]
};

const userRules = {
  tenantCode: [{ required: true, message: "请输入租户编码", trigger: "blur" }],
  username: [{ required: true, message: "请输入用户名", trigger: "blur" }],
  password: [{ required: true, message: "请输入密码", trigger: "blur" }]
};

const tenantRules = {
  tenantCode: [{ required: true, message: "请输入租户编码", trigger: "blur" }],
  username: [{ required: true, message: "请输入用户名", trigger: "blur" }],
  password: [{ required: true, message: "请输入密码", trigger: "blur" }]
};

// 管理员登录
const onAdminLogin = async () => {
  if (!adminFormRef.value) return;
  await adminFormRef.value.validate(valid => {
    if (valid) {
      loading.value = true;
      useUserStoreHook()
        .loginByUsername({
          username: adminForm.username,
          password: adminForm.password,
          loginType: "admin"
        })
        .then(res => {
          console.log("管理员登录响应:", res);
          if (res.code === 200) {
            disabled.value = true;
            message("管理员登录成功", { type: "success" });
            router.push("/").finally(() => (disabled.value = false));
          } else {
            message(res.message || "登录失败", { type: "error" });
          }
        })
        .catch(err => {
          console.error("登录错误:", err);
          message(err.response?.data?.message || err.message || "登录失败", { type: "error" });
        })
        .finally(() => (loading.value = false));
    }
  });
};

// 普通用户登录
const onUserLogin = async () => {
  if (!userFormRef.value) return;
  await userFormRef.value.validate(valid => {
    if (valid) {
      loading.value = true;
      useUserStoreHook()
        .loginByUsername({
          tenantCode: userForm.tenantCode,
          username: userForm.username,
          password: userForm.password,
          loginType: "user"
        })
        .then(res => {
          console.log("用户登录响应:", res);
          if (res.code === 200) {
            disabled.value = true;
            message("用户登录成功", { type: "success" });
            router.push("/").finally(() => (disabled.value = false));
          } else {
            message(res.message || "登录失败", { type: "error" });
          }
        })
        .catch(err => {
          console.error("登录错误:", err);
          message(err.response?.data?.message || err.message || "登录失败", { type: "error" });
        })
        .finally(() => (loading.value = false));
    }
  });
};

// 租户登录
const onTenantLogin = async () => {
  if (!tenantFormRef.value) return;
  await tenantFormRef.value.validate(valid => {
    if (valid) {
      loading.value = true;
      useUserStoreHook()
        .loginByUsername({
          tenantCode: tenantForm.tenantCode,
          username: tenantForm.username,
          password: tenantForm.password,
          loginType: "tenant"
        })
        .then(res => {
          console.log("租户登录响应:", res);
          if (res.code === 200) {
            disabled.value = true;
            message("租户登录成功", { type: "success" });
            router.push("/").finally(() => (disabled.value = false));
          } else {
            message(res.message || "登录失败", { type: "error" });
          }
        })
        .catch(err => {
          console.error("登录错误:", err);
          message(err.response?.data?.message || err.message || "登录失败", { type: "error" });
        })
        .finally(() => (loading.value = false));
    }
  });
};

const handleLogin = () => {
  if (activeTab.value === "admin") {
    onAdminLogin();
  } else if (activeTab.value === "user") {
    onUserLogin();
  } else if (activeTab.value === "tenant") {
    onTenantLogin();
  }
};

const immediateDebounce: any = debounce(
  () => handleLogin(),
  1000,
  true
);

useEventListener(document, "keydown", ({ code }) => {
  if (
    ["Enter", "NumpadEnter"].includes(code) &&
    !disabled.value &&
    !loading.value
  )
    immediateDebounce();
});
</script>

<template>
  <div class="select-none">
    <img :src="bg" class="wave" />
    <div class="flex-c absolute right-5 top-3">
      <!-- 主题 -->
      <el-switch
        v-model="dataTheme"
        inline-prompt
        :active-icon="dayIcon"
        :inactive-icon="darkIcon"
        @change="dataThemeChange"
      />
    </div>
    <div class="login-container">
      <div class="img">
        <component :is="toRaw(illustration)" />
      </div>
      <div class="login-box">
        <div class="login-form">
          <avatar class="avatar" />
          <Motion>
            <h2 class="outline-hidden">{{ title }}</h2>
          </Motion>

          <!-- 登录类型切换 -->
          <Motion :delay="50">
            <el-tabs v-model="activeTab" class="login-tabs">
              <!-- 管理员登录 -->
              <el-tab-pane label="管理员" name="admin">
                <el-form
                  ref="adminFormRef"
                  :model="adminForm"
                  :rules="adminRules"
                  size="large"
                  class="mt-4"
                >
                  <Motion :delay="100">
                    <el-form-item prop="username">
                      <el-input
                        v-model="adminForm.username"
                        clearable
                        placeholder="账号"
                        :prefix-icon="useRenderIcon(User)"
                        @keyup.enter="handleLogin"
                      />
                    </el-form-item>
                  </Motion>

                  <Motion :delay="150">
                    <el-form-item prop="password">
                      <el-input
                        v-model="adminForm.password"
                        clearable
                        show-password
                        placeholder="密码"
                        :prefix-icon="useRenderIcon(Lock)"
                        @keyup.enter="handleLogin"
                      />
                    </el-form-item>
                  </Motion>

                  <Motion :delay="250">
                    <el-button
                      class="w-full mt-4!"
                      size="default"
                      type="primary"
                      :loading="loading"
                      :disabled="disabled"
                      @click="handleLogin"
                    >
                      登录
                    </el-button>
                  </Motion>
                </el-form>
              </el-tab-pane>

              <!-- 普通用户登录 -->
              <el-tab-pane label="用户" name="user">
                <el-form
                  ref="userFormRef"
                  :model="userForm"
                  :rules="userRules"
                  size="large"
                  class="mt-4"
                >
                  <Motion :delay="100">
                    <el-form-item prop="tenantCode">
                      <el-input
                        v-model="userForm.tenantCode"
                        clearable
                        placeholder="租户编码"
                        @keyup.enter="handleLogin"
                      />
                    </el-form-item>
                  </Motion>

                  <Motion :delay="150">
                    <el-form-item prop="username">
                      <el-input
                        v-model="userForm.username"
                        clearable
                        placeholder="用户名"
                        :prefix-icon="useRenderIcon(User)"
                        @keyup.enter="handleLogin"
                      />
                    </el-form-item>
                  </Motion>

                  <Motion :delay="200">
                    <el-form-item prop="password">
                      <el-input
                        v-model="userForm.password"
                        clearable
                        show-password
                        placeholder="密码"
                        :prefix-icon="useRenderIcon(Lock)"
                        @keyup.enter="handleLogin"
                      />
                    </el-form-item>
                  </Motion>

                  <Motion :delay="250">
                    <el-button
                      class="w-full mt-4!"
                      size="default"
                      type="primary"
                      :loading="loading"
                      :disabled="disabled"
                      @click="handleLogin"
                    >
                      登录
                    </el-button>
                  </Motion>
                </el-form>
              </el-tab-pane>

              <!-- 租户登录 -->
              <el-tab-pane label="租户" name="tenant">
                <el-form
                  ref="tenantFormRef"
                  :model="tenantForm"
                  :rules="tenantRules"
                  size="large"
                  class="mt-4"
                >
                  <Motion :delay="100">
                    <el-form-item prop="tenantCode">
                      <el-input
                        v-model="tenantForm.tenantCode"
                        clearable
                        placeholder="租户编码"
                        @keyup.enter="handleLogin"
                      />
                    </el-form-item>
                  </Motion>

                  <Motion :delay="150">
                    <el-form-item prop="username">
                      <el-input
                        v-model="tenantForm.username"
                        clearable
                        placeholder="用户名"
                        :prefix-icon="useRenderIcon(User)"
                        @keyup.enter="handleLogin"
                      />
                    </el-form-item>
                  </Motion>

                  <Motion :delay="200">
                    <el-form-item prop="password">
                      <el-input
                        v-model="tenantForm.password"
                        clearable
                        show-password
                        placeholder="密码"
                        :prefix-icon="useRenderIcon(Lock)"
                        @keyup.enter="handleLogin"
                      />
                    </el-form-item>
                  </Motion>

                  <Motion :delay="250">
                    <el-button
                      class="w-full mt-4!"
                      size="default"
                      type="primary"
                      :loading="loading"
                      :disabled="disabled"
                      @click="handleLogin"
                    >
                      登录
                    </el-button>
                  </Motion>
                </el-form>
              </el-tab-pane>
            </el-tabs>
          </Motion>
        </div>
      </div>
    </div>
  </div>
</template>

<style scoped>
@import url("@/style/login.css");
</style>

<style lang="scss" scoped>
:deep(.login-tabs) {
  .el-tabs__header {
    margin-bottom: 20px;
  }
}

:deep(.el-input-group__append, .el-input-group__prepend) {
  padding: 0;
}
</style>
